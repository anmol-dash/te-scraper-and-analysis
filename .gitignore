# ── Secrets (never commit; this repo is public) ──────────────────────────
.env
.env.*
*.key
*_secret*
.gameca/
resend_key

# ── Python ───────────────────────────────────────────────────────────────
__pycache__/
.DS_Store

# ── Jupyter scratch (throwaway notebooks + autosave checkpoints) ──────────
.ipynb_checkpoints/
Untitled*.ipynb

# ── Nextflow runtime artifacts (work dirs, resumable session cache, logs) ─
work/
.nextflow/
.nextflow.log*

# ── ColabFold runtime artifacts (large; not source) ──────────────────────
colabfold_params/
*.sif

# ── LaTeX build intermediates (report PDFs/figures are committed, not these)
missfont.log
*.blg

# ── Frontend / Tauri / backend build output ──────────────────────────────
node_modules/
frontend/dist/
src-tauri/target/
backend/build/
backend/dist/
src-tauri/binaries/*
!src-tauri/binaries/.gitkeep
*.dmg

# ── Pipeline result folders (large generated outputs, regenerated per run) ─
results/
results_test/
iap_pres_nomotif/
stage11v4/
iapltr1a_mm/
mt2_mm/
l1md_gf/
results3/l1mdtf_i/
results4/l1mdtf_i/
results722v1/
the1res1/the1d-int/

# ── Generated pipeline outputs: bulk per-copy data, caches, result figures ─
# These are regenerated by the pipeline on every run and are not needed to run
# the program. reports8/ alone is ~500 MB of per-copy CSVs, caches and figures.
reports8/
report_figs/
clusters5.csv
*.npy
*.genome_cache.pkl
!mini_genome.genome_cache.pkl

# ── Generated result figures + measured-value macros at the repo root ──────
# (The manuscript keeps its own copies under terra_report/figs/, which stay
#  tracked — these root-anchored patterns deliberately do not match that path.)
/fig_*.pdf
/fig_*.png
/*_measured_values.tex
/*_values.tex

# ── Compiled report PDFs (the .tex/.bib sources stay tracked) ──────────────
gameca_report.pdf
grna_design_report.pdf

# ── LaTeX build intermediates ─────────────────────────────────────────────
*.aux
*.out
*.log
*.synctex.gz

# ── Review documents + Office lock files (not part of the program) ─────────
*.docx
~$*

# ── Ordered-reagent spreadsheets (unpublished designs; this repo is public) ─
*.xlsx
HERVK-int_LTR5_Hs_guide?candidates.xlsx
HERVK-int_LTR5_Hs_guide_candidates.xlsx
