// ─────────────────────────────────────────────────────────────────────────────
// GAMECA — TE analysis pipeline, Nextflow DSL2 orchestration layer.
//
// This wraps the existing query.py engine + run_*.py post-alignment analyses modules so that
//   • the pipeline runs *internally* on Nextflow (real parallelism + resume +
//     per-process LSF resources, replacing query.py's sequential subprocess
//     loop), and
//   • GAMECA can be *included as a subworkflow* inside any other nf-core-style
//     pipeline (see subworkflows/local/gameca.nf and README.md).
//
// Quick start:
//   nextflow run nextflow/main.nf --input samplesheet.csv --outdir results \
//       -profile lsf,singularity
//   nextflow run nextflow/main.nf -profile test,singularity      // stub smoke test
// ─────────────────────────────────────────────────────────────────────────────

nextflow.enable.dsl = 2

manifest {
    name            = 'gameca'
    author          = 'GAMECA'
    description     = 'Genome-wide Analysis of Mobile Element Copies & Ancestry'
    mainScript      = 'main.nf'
    homePage        = 'https://github.com/anmol-dash/te-scraper-and-analysis'
    defaultBranch   = 'main'
    nextflowVersion = '>=22.10.0'
    version         = '0.4.42'
}

params {
    // ── I/O ──────────────────────────────────────────────────────────────────
    input          = null            // samplesheet CSV: family,assembly,input
    family         = null            // single-run shortcut (used when --input is unset)
    assembly       = 'hg38'
    outdir         = 'results'
    genome_fasta   = null            // optional local reference FASTA on the exec host

    // ── post_alignment_analyses entry (nextflow/post_alignment_analyses.nf, used by query.py --post-alignment-analyses-nextflow)
    results        = null            // an existing GAMECA family output folder

    // ── behaviour ──────────────────────────────────────────────────────────────
    report_html    = true
    report_pdf     = false           // also render the LaTeX/PDF report
    skip_standout  = false           // core stages only (1-10), no post-alignment analyses modules
    skip_modules   = null            // comma/space-separated post-alignment module names to skip
                                      // (e.g. "fold" — mirrors query.py/run_stage11_all.py --skip)

    // ── engine ─────────────────────────────────────────────────────────────────
    gameca_home    = "${projectDir}/.."   // dir holding query.py + run_*.py
    container_sif  = null                 // path to gameca.sif (LSF/apptainer)
    // Canonical GAMECA image (single source of truth for the docker/singularity
    // profiles). Built + pushed from ../Dockerfile. Override with --container_image.
    container_image = 'ghcr.io/anmol-dash/gameca:latest'

    // Scheduler partition/queue for the `slurm` profile (null = site default).
    slurm_queue    = null

    // ── resource ceilings ──────────────────────────────────────────────────────
    max_cpus       = 16
    max_memory     = '128.GB'
    max_time       = '48.h'

    publish_dir_mode = 'copy'
    tracedir         = "${params.outdir}/pipeline_info"

    // ── single-run shortcut ──────────────────────────────────────────────────
    input_csv      = null            // prebuilt loci CSV when using --family

    // ── post-alignment analyses module knobs (mirror query.py defaults; null → module default)
    clock_divisor      = 1
    intact_orf_aa      = 100
    subst_rate         = null
    mafft_cmd          = null
    grna_cas           = 'SpCas9'
    grna_max_mm        = 2
    grna_background    = null
    tail_bp            = 150
    promoter_bp        = 200
    ctcf_preset        = null
    tads_preset        = null
    epigenetic_preset  = null
    ortholog_species   = null        // space/comma-separated list
    liftover_cmd       = null
    target_assemblies  = null        // space/comma-separated list
    colabfold_cmd      = null
    cpg_omega          = null
    min_ltr_identity   = null
}

// GAMECA_HOME is how every process locates query.py / run_*.py.
env {
    GAMECA_HOME    = params.gameca_home
    GAMECA_VERSION = '0.4.42'
    MPLBACKEND     = 'Agg'
}

profiles {
    standard  { process.executor = 'local' }

    lsf {
        process.executor       = 'lsf'
        process.queue          = 'normal'
        executor.perJobMemLimit = true          // LSF -M is per-job on most sites
    }

    slurm {
        process.executor       = 'slurm'
        // Override for your site's partition, e.g. -profile slurm --slurm_queue gpu
        process.queue          = params.slurm_queue ?: null
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        // Prefer a prebuilt gameca.sif (as CONTAINER_SIF in hpc_client.py); else
        // pull the canonical image over docker://.
        process.container      = params.container_sif ?: "docker://${params.container_image}"
    }

    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
        process.container      = params.container_image
    }

    test { includeConfig 'conf/test.config' }
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

// ── reporting ────────────────────────────────────────────────────────────────
timeline { enabled = true; file = "${params.tracedir}/execution_timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.tracedir}/execution_report.html";   overwrite = true }
trace    { enabled = true; file = "${params.tracedir}/execution_trace.txt";     overwrite = true }
dag      { enabled = true; file = "${params.tracedir}/pipeline_dag.html";       overwrite = true }
