// Smoke test — validates config parsing + the whole DAG using process stubs.
// `stubRun = true` means a plain run exercises every process' stub (no genome,
// network, or heavy deps), so you can catch config/channel/wiring errors with:
//
//   nextflow run nextflow/main.nf -profile test
//
// (no need to remember -stub-run). Resources are tiny so it runs on any laptop.

params {
    input         = "${projectDir}/assets/samplesheet.csv"
    outdir        = 'results_test'
    report_pdf    = false
    max_cpus      = 2
    max_memory    = '4.GB'
    max_time      = '1.h'
}

stubRun = true
