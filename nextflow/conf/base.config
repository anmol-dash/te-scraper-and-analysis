// Resource labels → LSF/local requests. `resourceLimits` (Nextflow ≥24.04)
// auto-clamps every request to the params.max_* ceilings, so a big family never
// asks for more than the site allows. Each label scales with task.attempt on retry.

process {
    resourceLimits = [
        cpus:   (params.max_cpus   as int),
        memory: (params.max_memory as nextflow.util.MemoryUnit),
        time:   (params.max_time   as nextflow.util.Duration)
    ]

    cpus   = { 1    * task.attempt }
    memory = { 6.GB * task.attempt }
    time   = { 4.h  * task.attempt }

    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 1
    maxErrors     = '-1'

    withLabel:process_low {
        cpus   = { 2    * task.attempt }
        memory = { 8.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withLabel:process_medium {
        cpus   = { 4     * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    // GAMECA_CORE loads hg38 (~3.1 GB) into memory; give it headroom (see MEMORY.md).
    withLabel:process_high {
        cpus   = { 4     * task.attempt }
        memory = { 24.GB * task.attempt }
        time   = { 24.h  * task.attempt }
    }
    withLabel:process_long {
        time   = { 48.h  * task.attempt }
    }
}
