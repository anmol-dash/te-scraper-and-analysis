// Per-process publishing + extra CLI args. Anything a process appends via
// task.ext.args is passed straight through to query.py / run_*.py, so users can
// tune the engine without editing module code:
//   nextflow run ... --outdir res \
//       --core_args '--kmer 8 --max-loci 500' -profile lsf

process {
    withName: 'GAMECA_GENOME' {
        ext.prefix = { meta.id.toLowerCase() }
        ext.args   = { params.core_args ?: '' }
        publishDir = [ enabled: false ]
    }

    withName: 'GAMECA_DATA|GAMECA_SEQUENCES|GAMECA_STATS|GAMECA_CLUSTERING|GAMECA_DASHBOARD|GAMECA_ALIGNMENT|GAMECA_MOTIF|GAMECA_PRIMERS' {
        ext.args   = { params.core_args ?: '' }
        publishDir = [ enabled: false ]
    }

    withName: 'GAMECA_MERGE' {
        // Folds the four parallel post-clustering branches back into one folder.
        // Publish here so `--skip_standout` runs still end up with a complete
        // outdir/<family>/ tree even though GAMECA_REPORT never runs in that case.
        publishDir = [
            path: { params.outdir },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'GAMECA_STANDOUT' {
        // post-alignment analyses modules are I/O + CPU light individually; run many in parallel.
        publishDir = [ enabled: false ]
    }

    withName: 'GAMECA_REPORT' {
        // Emitted paths already carry the family folder (<prefix>/...), so publish
        // to outdir directly to avoid double-nesting (outdir/<fam>/<fam>).
        publishDir = [
            path: { params.outdir },
            mode: params.publish_dir_mode,
            saveAs: { fn -> fn.equals('versions.yml') ? null : fn }
        ]
    }
}

params {
    core_args = null
}
