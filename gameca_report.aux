\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces GAMECA pipeline flowchart. A family/assembly request flows through the seven core \texttt  {query.py} stages (Prep, Clustering, Alignment, Motif, GO, Expression, Primers) and into the Stage-11 standout-analysis modules (Figure~\ref {fig:stage11overview}), which run in parallel; outputs are gathered into a per-family folder and LaTeX report. The whole run executes inside the Nextflow DSL2 / Singularity environment on an LSF or SLURM scheduler.}}{4}{figure.caption.3}\protected@file@percent }
\newlabel{fig:flowchart}{{2}{4}{GAMECA pipeline flowchart. A family/assembly request flows through the seven core \texttt {query.py} stages (Prep, Clustering, Alignment, Motif, GO, Expression, Primers) and into the Stage-11 standout-analysis modules (Figure~\ref {fig:stage11overview}), which run in parallel; outputs are gathered into a per-family folder and LaTeX report. The whole run executes inside the Nextflow DSL2 / Singularity environment on an LSF or SLURM scheduler}{figure.caption.3}{}}
