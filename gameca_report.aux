\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Nextflow DSL2 orchestration. \texttt  {GAMECA\_CORE} runs \texttt  {query.py} Stages 1--10; the \texttt  {STANDOUT} subworkflow scatters the copy-resolved analysis modules into independent, individually-resourced \texttt  {GAMECA\_STANDOUT} tasks that run in parallel and are gathered back per family. The composable \texttt  {GAMECA} subworkflow (\texttt  {CORE} $\to $ \texttt  {STANDOUT}) is importable into other DSL2 pipelines; execution backend and container runtime are chosen by profile (\texttt  {lsf}/\texttt  {slurm}, \texttt  {singularity}/\texttt  {docker}).}}{8}{figure.caption.14}\protected@file@percent }
\newlabel{fig:nextflow}{{4}{8}{Nextflow DSL2 orchestration. \texttt {GAMECA\_CORE} runs \texttt {query.py} Stages 1--10; the \texttt {STANDOUT} subworkflow scatters the copy-resolved analysis modules into independent, individually-resourced \texttt {GAMECA\_STANDOUT} tasks that run in parallel and are gathered back per family. The composable \texttt {GAMECA} subworkflow (\texttt {CORE} $\to $ \texttt {STANDOUT}) is importable into other DSL2 pipelines; execution backend and container runtime are chosen by profile (\texttt {lsf}/\texttt {slurm}, \texttt {singularity}/\texttt {docker})}{figure.caption.14}{}}
